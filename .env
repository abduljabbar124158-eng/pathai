# Copy this file to .env and fill in your values.
# You only need ONE of the AI providers below - pick whichever key you have.

# Which provider to use: "openai", "gemini", "groq", "huggingface", or "mock"
# "mock" works with NO key at all -- great for testing the app end-to-end
# before you have a real key, or as a safety net during a live demo.
#
# TIP -- fallback chain: you can list more than one provider, comma-separated,
# and the app will try them in order, falling through to the next one if a
# provider is rate-limited or errors out. Example:
#   AI_PROVIDER=gemini,groq,mock
AI_PROVIDER=mock

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Groq (fast, generous free tier, no credit card -- console.groq.com) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- HuggingFace Inference API ---
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# Flask secret key (any random string is fine)
SECRET_KEY=change-this-to-a-random-string

# Database (defaults to a local SQLite file -- fine for the internship submission)
DATABASE_URL=sqlite:///pathai.db
