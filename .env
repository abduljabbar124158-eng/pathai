# NOTE: ye PUBLIC copy hai — sirf structure/defaults. REAL keys apni local .env me rakho.
# PathAI environment configuration.
# Copy this file to .env  (cp .env.example .env)  and fill in what you have.
#
# You only need ONE provider key to run live AI. Everything also works with
# NO key at all — the app then runs in offline demo mode so you can test all
# 8 features immediately.

# ---------------------------------------------------------------------------
# AI_PROVIDER — the fallback chain, tried left to right.
# If the first provider has no key, is rate-limited or errors, the next one
# is tried automatically, and "mock" is the final offline fallback.
# ---------------------------------------------------------------------------
AI_PROVIDER=groq,gemini,openai,cerebras,openrouter,pollinations,mock

# --- Pollinations (100% free, NO KEY NEEDED: https://pollinations.ai) ---
POLLINATIONS_MODEL=openai

# --- Google Gemini (free tier: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Groq (fast open models; free tier, no card: console.groq.com) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- OpenAI / ChatGPT (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Cerebras (fastest free inference; free key: https://cloud.cerebras.ai) ---
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3.8-27b

# --- OpenRouter (free key: https://openrouter.ai/keys — pick a ":free" model) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# --- Server ---
PORT=3000
